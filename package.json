{
  "name": "color-schemes-js",
  "version": "0.1.1",
  "description": "Pre-defined color schemes and color evaluation tools, inspired by Julia's ColorSchemes.jl, in TypeScript.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run test && npm run typecheck && npm run build"
  },
  "keywords": [
    "colorscheme",
    "colorschemes",
    "color",
    "palette",
    "colormap",
    "visualization",
    "typescript"
  ],
  "author": {
    "name": "Lazaro Alonso",
    "email": "lazarus.alon@gmail.com",
    "url": "https://lazarusa.github.io"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lazarusA/color-schemes-js.git"
  },
  "homepage": "https://github.com/lazarusA/color-schemes-js#readme",
  "bugs": {
    "url": "https://github.com/lazarusA/color-schemes-js/issues"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
